{
  "name": "Maria Portfolio",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:20",
  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": { "label": "Portfolio", "onAutoForward": "openPreview" }
  },
  "postAttachCommand": "npm start",
  "customizations": {
    "vscode": {
      "extensions": ["esbenp.prettier-vscode", "ritwickdey.LiveServer"]
    }
  }
}
